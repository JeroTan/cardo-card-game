{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "./dist/_worker.js/index.js",
	"name": "cardo-card-game",
	"compatibility_date": "2025-03-25",
	"compatibility_flags": [
		// Enable Node.js API
		// see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
		"nodejs_compat",
		// Allow to fetch URLs in your app
		// see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
		"global_fetch_strictly_public",
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"preview_urls": false,
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"ai": {
		"binding": "AI",
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ChatRoom",
				"name": "CHAT_ROOM",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatRoom"],
		},
	],
	"env": {
		"production": {
			// "routes": [ // This is for creating custom domains
			//   {
			//     "pattern": "[your-domain].com.ph",
			//     "custom_domain": true
			//   }
			// ],
			"vars": {
				"SECRET_ENVIRONMENT_STATUS": "live", // For declaring if it is in maintenance or not
			},
			// "kv_namespaces": [
			//   {
			//     "binding": "x--kv-namespace--x",
			//     "id": "x--kv-id--x",
			//   }
			// ],
			"durable_objects": {
				"bindings": [
					{
						"class_name": "ChatRoom",
						"name": "CHAT_ROOM",
					},
				],
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["ChatRoom"],
				},
			],
			"name": "cardo-card-game",
			"ai": {
				"binding": "AI",
			},
		},
		"staging": {
			"vars": {
				"SECRET_ENVIRONMENT_STATUS": "live", // For declaring if it is in maintenance or not
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "ChatRoom",
						"name": "CHAT_ROOM",
					},
				],
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["ChatRoom"],
				},
			],
			"name": "cardo-card-game-staging",
			"ai": {
				"binding": "AI",
			},
		},
	},
}

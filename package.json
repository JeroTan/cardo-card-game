{
	"name": "cardo-card-game",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"check": "astro check",
		"test": "vitest",
		"build": "astro check && vitest run && astro build",
		"deploy-development": "npx wrangler@latest deploy --env=\"development\" && npx wrangler d1 execute cardo-db-development --file=db/card-db-schema.sql",
		"deploy-staging": "npx wrangler@latest deploy --env=\"staging\"",
		"deploy-production": "npx wrangler@latest deploy --env=\"production\"",
		"prettier": "prettier --write .",
		"preview": "astro preview",
		"astro": "astro",
		"wrangler-types": "wrangler types"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.4",
		"@astrojs/cloudflare": "^12.6.9",
		"@astrojs/react": "^4.4.2",
		"@astrojs/sitemap": "^3.6.0",
		"@radix-ui/react-slot": "^1.2.4",
		"@tailwindcss/vite": "^4.1.14",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"astro": "^5.14.1",
		"astro-seo": "^0.8.4",
		"axios": "^1.12.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lodash": "^4.17.21",
		"lucide-react": "^0.556.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"schema-dts": "^1.1.5",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.14"
	},
	"devDependencies": {
		"@types/lodash": "^4.17.20",
		"prettier": "3.6.2",
		"tw-animate-css": "^1.4.0",
		"vitest": "^3.2.4",
		"wrangler": "^4.42.2"
	}
}

---
import { ProcessingListLarge } from "@/components/listing/ProcessingList";
import { Skeleton } from "@/components/ui/skeleton";
import PackEditPage from "@/features/admin/pack/edit/PackEditPage";
import PagePlateAdmin from "@/layouts/PagePlateAdmin.astro";
const id = Astro.params.id;
if (id === undefined) {
	throw new Error("ID is undefined");
}
---

<PagePlateAdmin title="Admin Dashboard - CARDO">
	<main class="mx-auto max-w-full w-full mb-10 mt-2">
		<PackEditPage id={id} client:only="react" server:defer>
			<div slot="fallback">
				<Skeleton client:load className="w-full h-30 mb-2" />
				<ProcessingListLarge client:load />
			</div>
		</PackEditPage>
	</main>
</PagePlateAdmin>

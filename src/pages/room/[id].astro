---
import { Skeleton } from "@/components/ui/skeleton";
import MainGame from "@/features/game/MainGame";
import PagePlate from "@/layouts/PagePlate.astro";

const roomId = Astro.params.id;
if (roomId == undefined) {
	return Astro.redirect("/404");
}
---

<PagePlate title="CardO - Game Room">
	<div class="py-10">
		<div class="flex justify-center">
			<div class="h-[calc(100vh-4rem)] aspect-video relative">
				<MainGame client:only="react" roomId={roomId}>
					<div slot="fallback" class="size-full relative">
						<Skeleton client:load className="size-full" />
					</div>
				</MainGame>
			</div>
		</div>
	</div>
</PagePlate>

---
import PagePlate from '@/layouts/PagePlate.astro';
import QuickJoinByCode from '@/features/game/room/QuickJoinByCode';
import { getPlayerOnSession } from '@/services/game/MatchmakingLogic';

const { playerId } = getPlayerOnSession(Astro.cookies);
const code = Astro.params.code;

if (!playerId) {
  return Astro.redirect('/');
}

if (!code || code.length !== 6) {
  return Astro.redirect('/custom-room');
}
---

<PagePlate title="CARDO - Join Room">
  <QuickJoinByCode 
    client:load 
    userId={playerId}
    code={code.toUpperCase()}
  />
</PagePlate>
